{
    "name": "ksfraser/ksf-fa-upc2item",
    "description": "UPC2Item - Scan barcodes/UPCs, search Amazon/EBay/Facebook Marketplace, and import products into FA Items/Inventory with pricebook mapping.",
    "type": "library",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=7.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-dom": "*",
        "ksfraser/ksf-fa-common": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "ksfraser/famock": "*"
    },
    "autoload": {
        "psr-4": {
            "ksfraser\\FrontAccounting\\Upc2Item\\": "src/Ksfraser/FrontAccounting/Upc2Item/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Unit\\": "tests/Unit/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    },
    "minimum-stability": "stable",
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    }
}
